@page
@model EventsAndPolls.Pages.Account.RegisterModel
@{
     Layout = "_Layout";
     ViewData["Title"] = "Înregistrare";
}

<div class="container mt-5">
     <div class="row justify-content-center">
          <div class="col-md-5">
               <div class="card shadow-sm">
                    <div class="card-body p-4">
                         <h2 class="card-title mb-4 text-center">Crează cont</h2>

                         <form method="post">
                              <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                              <div class="mb-3">
                                   <label asp-for="Input.DisplayName" class="form-label"></label>
                                   <input asp-for="Input.DisplayName" class="form-control" placeholder="Numele tău" />
                                   <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
                              </div>

                              <div class="mb-3">
                                   <label asp-for="Input.Email" class="form-label"></label>
                                   <input asp-for="Input.Email" class="form-control" placeholder="email@exemplu.com" />
                                   <span asp-validation-for="Input.Email" class="text-danger"></span>
                              </div>

                              <div class="mb-3">
                                   <label asp-for="Input.Password" class="form-label"></label>
                                   <input asp-for="Input.Password" class="form-control" type="password" />
                                   <span asp-validation-for="Input.Password" class="text-danger"></span>
                              </div>

                              <div class="mb-3">
                                   <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                                   <input asp-for="Input.ConfirmPassword" class="form-control" type="password" />
                                   <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                              </div>

                              <div class="d-grid">
                                   <button type="submit" class="btn btn-primary">Înregistrare</button>
                              </div>

                              <div class="text-center mt-3">
                                   <a asp-page="/Account/Login">Ai deja cont? Autentifică-te</a>
                              </div>
                         </form>
                    </div>
               </div>
          </div>
     </div>
</div>

@section Scripts {
     <partial name="_ValidationScriptsPartial" />
}