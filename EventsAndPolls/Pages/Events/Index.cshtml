@page
@{
     Layout = "_Layout";
     ViewData["Title"] = "Evenimente";
     bool isOrganizer = User.IsInRole("Organizer");
}

<div class="container mt-4">
     <div class="d-flex justify-content-between align-items-center mb-4">
          <h1>Evenimente</h1>
          @* Only organizers see Create Event button *@
          @if (isOrganizer)
          {
               <a href="/Events/Create" class="btn btn-primary">+ Eveniment nou</a>
          }
     </div>

     <div id="eventsList" class="row">
          <div class="col-12 text-center">
               <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
               </div>
               <p class="mt-2">Se încarcă evenimentele...</p>
          </div>
     </div>
</div>

@section Scripts {
     <script>
          const isOrganizer = @Json.Serialize(isOrganizer);

          async function loadEvents() {
              const container = document.getElementById('eventsList');
              try {
                  const response = await fetch('/api/events');
                  if (!response.ok) throw new Error(`HTTP error: ${response.status}`);

                  const events = await response.json();

                  if (!events || events.length === 0) {
                      container.innerHTML = '<div class="col-12 text-center py-5"><p class="lead">Nu există evenimente. Creează primul!</p></div>';
                      return;
                  }

                  container.innerHTML = events.map(event => {
                      const startDate = new Date(event.startDate).toLocaleString();
                      const statusBadge = event.isActive
                          ? '<span class="badge bg-success">Activ</span>'
                          : '<span class="badge bg-secondary">Inactiv</span>';

                      return `
                          <div class="col-md-4 mb-4">
                              <div class="card h-100">
                                  <div class="card-body">
                                      <div class="d-flex justify-content-between align-items-start mb-2">
                                          <h5 class="card-title mb-0">${event.title}</h5>
                                          ${statusBadge}
                                      </div>
                                      <p class="card-text text-muted">
                                          ${event.description.substring(0, 100)}${event.description.length > 100 ? '...' : ''}
                                      </p>
                                      <p class="card-text">
                                          <small class="text-muted">
                                              📅 ${startDate}<br>
                                              📍 ${event.location}<br>
                                              👥 Max: ${event.maxParticipants} &nbsp;|&nbsp; 📊 Sondaje: ${event.pollCount}
                                          </small>
                                      </p>
                                      <a href="/Events/Details/${event.id}" class="btn btn-outline-primary btn-sm">
                                          Vezi detalii
                                      </a>
                                  </div>
                              </div>
                          </div>
                      `;
                  }).join('');

              } catch (error) {
                  container.innerHTML = `
                      <div class="col-12 text-center text-danger">
                          <p>Eroare la încărcarea evenimentelor: ${error.message}</p>
                          <button onclick="loadEvents()" class="btn btn-primary mt-3">Reîncearcă</button>
                      </div>
                  `;
              }
          }

          document.addEventListener('DOMContentLoaded', loadEvents);
     </script>
}