@page
@{
     ViewData["Title"] = "Events";
}

<div class="container mt-4">
     <h1>Events</h1>

     <div class="d-flex justify-content-between mb-4">
          <a href="/Events/Create" class="btn btn-primary">Create New Event</a>
     </div>

     <div id="message" class="alert" style="display: none;"></div>

     <div id="eventsList" class="row">
          <div class="text-center">
               <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
               </div>
          </div>
     </div>
</div>

@section Scripts {
     <script>
          async function loadEvents() {
              try {
                  const response = await fetch('/api/events');
                  const events = await response.json();

                  const container = document.getElementById('eventsList');

                  if (events.length === 0) {
                      container.innerHTML = '<div class="col-12 text-center py-5"><p class="lead">No events found. Create the first one!</p></div>';
                      return;
                  }

                  let html = '';
                  events.forEach(event => {
                      const startDate = new Date(event.startDate).toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric',
                          hour: '2-digit',
                          minute: '2-digit'
                      });

                      html += `
                          <div class="col-md-4 mb-4">
                              <div class="card h-100">
                                  <div class="card-body">
                                      <h5 class="card-title">${event.title}</h5>
                                      <p class="card-text">${event.description.substring(0, 100)}${event.description.length > 100 ? '...' : ''}</p>
                                      <p class="card-text">
                                          <small class="text-muted">
                                              <i class="bi bi-calendar"></i> ${startDate}<br>
                                              <i class="bi bi-geo-alt"></i> ${event.location}<br>
                                              <i class="bi bi-people"></i> Max: ${event.maxParticipants} | Polls: ${event.pollCount}
                                          </small>
                                      </p>
                                      <a href="/Events/Details?id=${event.id}" class="btn btn-outline-primary btn-sm">View Details</a>
                                  </div>
                                  <div class="card-footer">
                                      <small class="text-muted">Created: ${new Date(event.createdAt).toLocaleDateString()}</small>
                                  </div>
                              </div>
                          </div>
                      `;
                  });

                  container.innerHTML = html;

              } catch (error) {
                  console.error('Error:', error);
                  document.getElementById('eventsList').innerHTML = `
                      <div class="col-12 text-center text-danger">
                          <p>Error loading events. Please try again.</p>
                      </div>
                  `;

                  showMessage('error', 'Failed to load events');
              }
          }

          function showMessage(type, text) {
              const msgDiv = document.getElementById('message');
              msgDiv.style.display = 'block';
              msgDiv.className = `alert alert-${type === 'error' ? 'danger' : 'info'}`;
              msgDiv.textContent = text;

              setTimeout(() => {
                  msgDiv.style.display = 'none';
              }, 3000);
          }

          // Load events when page loads
          loadEvents();
     </script>
}