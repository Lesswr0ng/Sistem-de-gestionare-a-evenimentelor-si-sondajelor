@page "{id}"
@{
     Layout = "_Layout";
     ViewData["Title"] = "Event Details";
}

<div class="container mt-4">
     <div id="message" class="alert" style="display: none;"></div>

     <div id="loadingSpinner" class="text-center">
          <div class="spinner-border text-primary" role="status">
               <span class="visually-hidden">Loading...</span>
          </div>
     </div>

     <div id="eventDetails" style="display: none;">
          <div class="d-flex justify-content-between align-items-start mb-1">
               <h1 id="eventTitle"></h1>
          </div>
          <p id="eventDescription" class="lead"></p>

          <div class="d-flex align-items-center gap-2 mb-4">
               <span class="text-muted small">Export event:</span>
               <a id="exportJson" href="#" class="btn btn-sm btn-outline-secondary">
                    ⬇ JSON
               </a>
               <a id="exportTxt" href="#" class="btn btn-sm btn-outline-secondary">
                    ⬇ Text Report
               </a>
          </div>

          <div class="row mt-2">
               <div class="col-md-8">
                    <div class="card mb-4">
                         <div class="card-header">
                              <h5>Polls</h5>
                         </div>
                         <div class="card-body">
                              <div id="pollsList">
                                   <p class="text-muted">Loading polls...</p>
                              </div>
                              <a href="/Polls/Create?eventId=@(ViewContext.RouteData.Values["id"])"
                                 class="btn btn-success mt-3">Create New Poll</a>
                         </div>
                    </div>
               </div>

               <div class="col-md-4">
                    <div class="card">
                         <div class="card-header">
                              <h5>Event Info</h5>
                         </div>
                         <div class="card-body">
                              <ul class="list-unstyled">
                                   <li><strong>Start:</strong> <span id="startDate"></span></li>
                                   <li><strong>End:</strong> <span id="endDate"></span></li>
                                   <li><strong>Location:</strong> <span id="location"></span></li>
                                   <li><strong>Max Participants:</strong> <span id="maxParticipants"></span></li>
                                   <li><strong>Created:</strong> <span id="createdAt"></span></li>
                              </ul>
                         </div>
                    </div>
               </div>
          </div>
     </div>

     <div class="mt-3">
          <a href="/Events" class="btn btn-secondary">Back to Events</a>
     </div>
</div>

@section Scripts {
     <script>
          console.log('🔵 Details page loaded');

          const pathParts = window.location.pathname.split('/');
          const eventId = pathParts[pathParts.length - 1];

          // ── Adapter: wire up export links once we have the eventId ─────────
          document.getElementById('exportJson').href = `/api/export/event/${eventId}?format=json`;
          document.getElementById('exportTxt').href  = `/api/export/event/${eventId}?format=txt`;

          async function loadEventDetails() {
              try {
                  const response = await fetch(`/api/events/${eventId}`);
                  if (!response.ok) throw new Error(`Event not found (${response.status})`);

                  const event = await response.json();

                  document.getElementById('eventTitle').textContent        = event.title;
                  document.getElementById('eventDescription').textContent  = event.description;
                  document.getElementById('startDate').textContent         = new Date(event.startDate).toLocaleString();
                  document.getElementById('endDate').textContent           = new Date(event.endDate).toLocaleString();
                  document.getElementById('location').textContent          = event.location;
                  document.getElementById('maxParticipants').textContent   = event.maxParticipants;
                  document.getElementById('createdAt').textContent         = new Date(event.createdAt).toLocaleDateString();

                  document.getElementById('loadingSpinner').style.display = 'none';
                  document.getElementById('eventDetails').style.display   = 'block';

                  loadPolls();
              } catch (error) {
                  console.error('❌ Error:', error);
                  document.getElementById('loadingSpinner').innerHTML = `
                      <div class="alert alert-danger">
                          Error loading event: ${error.message}
                      </div>
                  `;
              }
          }

          function loadPolls() {
              fetch(`/api/events/${eventId}/polls`)
                  .then(response => response.json())
                  .then(polls => {
                      const container = document.getElementById('pollsList');
                      if (polls.length === 0) {
                          container.innerHTML = '<p class="text-muted">Nu există sondaje.</p>';
                          return;
                      }

                      let html = '';
                      polls.forEach(poll => {
                          const icon = poll.allowMultipleChoices ? '☑️' : '🔘';
                          html += `
                              <div class="card mb-2">
                                  <div class="card-body">
                                      <div class="d-flex justify-content-between">
                                          <h6>${icon} ${poll.question}</h6>
                                          <span class="badge bg-secondary">${poll.totalVotes} voturi</span>
                                      </div>
                                      <div class="d-flex gap-2 mt-2">
                                          <a href="/Polls/Details?id=${poll.id}"
                                             class="btn btn-sm btn-outline-primary">Vezi sondaj</a>
                                          <a href="/api/export/poll/${poll.id}?format=json"
                                             class="btn btn-sm btn-outline-secondary">⬇ JSON</a>
                                          <a href="/api/export/poll/${poll.id}?format=txt"
                                             class="btn btn-sm btn-outline-secondary">⬇ Text</a>
                                      </div>
                                  </div>
                              </div>
                          `;
                      });
                      container.innerHTML = html;
                  });
          }

          loadEventDetails();
     </script>
}