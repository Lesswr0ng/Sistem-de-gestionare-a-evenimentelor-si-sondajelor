@page
@{
     Layout = "_Layout";
     ViewData["Title"] = "Detalii Sondaj";
     var pollId = Request.Query["id"];
     bool isOrganizer = User.IsInRole("Organizer");
     bool isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<div class="container mt-4">
     <div id="loadingSpinner" class="text-center">
          <div class="spinner-border text-primary" role="status">
               <span class="visually-hidden">Loading...</span>
          </div>
     </div>

     <div id="pollDetails" style="display: none;">
          <div class="d-flex justify-content-between align-items-center mb-2">
               <h1 id="pollQuestion"></h1>
               <span id="pollTypeBadge" class="badge bg-info fs-6"></span>
          </div>
          <p class="text-muted" id="pollStatus"></p>

          @* Export — only organizers *@
          @if (isOrganizer)
          {
               <div class="d-flex align-items-center gap-2 mb-4">
                    <span class="text-muted small">Export:</span>
                    <a id="exportJson" href="#" class="btn btn-sm btn-outline-secondary">⬇ JSON</a>
                    <a id="exportTxt" href="#" class="btn btn-sm btn-outline-secondary">⬇ Text Report</a>
               </div>
          }

          <div class="row">
               <div class="col-md-6">
                    <div class="card">
                         <div class="card-header">
                              <h5>Votează</h5>
                         </div>
                         <div class="card-body">
                              <div id="voteOptions"></div>

                              @* Vote button — only authenticated users *@
                              @if (isAuthenticated)
                              {
                                   <button id="submitVote" class="btn btn-primary mt-3">Trimite Vot</button>
                              }
                              else
                              {
                                   <p class="text-muted mt-3">
                                        <a asp-page="/Account/Login">Autentifică-te</a> pentru a vota.
                                   </p>
                              }
                         </div>
                    </div>
               </div>

               <div class="col-md-6">
                    <div class="card">
                         <div class="card-header">
                              <h5>Rezultate</h5>
                         </div>
                         <div class="card-body">
                              <div id="results"></div>
                         </div>
                    </div>
               </div>
          </div>

          @* Clone button — only organizers *@
          @if (isOrganizer)
          {
               <div class="mt-3">
                    <a id="editPollBtn" asp-page="/Polls/Edit"
                       asp-route-id="@pollId"
                       class="btn btn-outline-warning">
                         ✏️ Editează Sondaj
                    </a>
                    <button type="button" class="btn btn-outline-info"
                            data-bs-toggle="modal" data-bs-target="#cloneModal">
                         📋 Clonează Sondaj
                    </button>
               </div>
          }
     </div>

     <div class="mt-3">
          <a href="javascript:history.back()" class="btn btn-secondary">Înapoi</a>
     </div>
</div>

@* Clone modal — only rendered for organizers *@
@if (isOrganizer)
{
     <div class="modal fade" id="cloneModal" tabindex="-1">
          <div class="modal-dialog">
               <div class="modal-content">
                    <div class="modal-header">
                         <h5 class="modal-title">Clonează Sondaj</h5>
                         <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                         <input type="hidden" id="sourcePollId" value="@pollId">
                         <div class="mb-3">
                              <label for="targetEventId" class="form-label">Eveniment țintă (opțional)</label>
                              <select class="form-select" id="targetEventId">
                                   <option value="">Același eveniment</option>
                              </select>
                         </div>
                         <div class="mb-3">
                              <label for="newQuestion" class="form-label">Întrebare nouă (opțional)</label>
                              <input type="text" class="form-control" id="newQuestion"
                                     placeholder="Lasă gol pentru aceeași întrebare">
                         </div>
                         <div class="form-check mb-3">
                              <input class="form-check-input" type="checkbox" id="deepClone" checked>
                              <label class="form-check-label" for="deepClone">
                                   Clonează și opțiunile (Deep Clone)
                              </label>
                         </div>
                    </div>
                    <div class="modal-footer">
                         <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anulează</button>
                         <button type="button" class="btn btn-primary" id="confirmClone">Clonează</button>
                    </div>
               </div>
          </div>
     </div>
}

@section Scripts {
     <script>
          const pollId       = new URLSearchParams(window.location.search).get('id');
          const isOrganizer  = @Json.Serialize(isOrganizer);
          const isAuthenticated = @Json.Serialize(isAuthenticated);

          // Export links for organizers
          const exportJson = document.getElementById('exportJson');
          const exportTxt  = document.getElementById('exportTxt');
          if (exportJson) exportJson.href = `/api/export/poll/${pollId}?format=json`;
          if (exportTxt)  exportTxt.href  = `/api/export/poll/${pollId}?format=txt`;

          async function loadPoll() {
              try {
                  // FIX: use /results endpoint for vote counts — not cached
                  const [pollRes, resultsRes] = await Promise.all([
                      fetch(`/api/polls/${pollId}`),
                      fetch(`/api/polls/${pollId}/results`)
                  ]);

                  if (!pollRes.ok) throw new Error('Sondaj negăsit');

                  const poll    = await pollRes.json();
                  // Results has fresh vote counts, merge options from it
                  const results = resultsRes.ok ? await resultsRes.json() : poll;

                  document.getElementById('pollQuestion').textContent  = poll.question;
                  document.getElementById('pollStatus').textContent    = poll.isActive ? 'Activ' : 'Închis';
                  document.getElementById('pollTypeBadge').textContent =
                      poll.allowMultipleChoices ? '✅ Multiple Choice' : '🔘 Single Choice';

                  renderVoteOptions(poll);
                  // Use results (fresh) for vote count display
                  renderResults(results);

                  document.getElementById('loadingSpinner').style.display = 'none';
                  document.getElementById('pollDetails').style.display    = 'block';
              } catch (error) {
                  document.getElementById('loadingSpinner').innerHTML =
                      '<p class="text-danger">Sondaj negăsit</p>';
              }
          }

          function renderVoteOptions(poll) {
              const container = document.getElementById('voteOptions');
              if (!poll.isActive) {
                  container.innerHTML = '<p class="text-muted">Acest sondaj este închis.</p>';
                  const btn = document.getElementById('submitVote');
                  if (btn) btn.disabled = true;
                  return;
              }

              const inputType = poll.allowMultipleChoices ? 'checkbox' : 'radio';
              container.innerHTML = poll.options.map(option => `
                  <div class="form-check">
                      <input class="form-check-input" type="${inputType}"
                             name="voteOption" value="${option.id}" id="opt${option.id}">
                      <label class="form-check-label" for="opt${option.id}">
                          ${option.text}
                      </label>
                  </div>
              `).join('');
          }

          function renderResults(poll) {
              const container = document.getElementById('results');
              if (!poll.options?.length) {
                  container.innerHTML = '<p>Nu există rezultate încă.</p>';
                  return;
              }
              container.innerHTML = '<ul class="list-group">' +
                  poll.options.map(option => `
                      <li class="list-group-item d-flex justify-content-between align-items-center">
                          ${option.text}
                          <span class="badge bg-primary rounded-pill">
                              ${option.voteCount} voturi (${option.percentage || 0}%)
                          </span>
                      </li>
                  `).join('') +
              '</ul>';
          }

          // Submit vote
          const submitBtn = document.getElementById('submitVote');
          if (submitBtn) {
              submitBtn.addEventListener('click', async () => {
                  const selected = [...document.querySelectorAll('input[name="voteOption"]:checked')]
                      .map(cb => parseInt(cb.value));

                  if (!selected.length) {
                      alert('Selectează cel puțin o opțiune.');
                      return;
                  }

                  try {
                      const res = await fetch(`/api/polls/${pollId}/votes`, {
                          method: 'POST',
                          headers: { 'Content-Type': 'application/json' },
                          body: JSON.stringify({ pollId: parseInt(pollId), selectedOptionIds: selected })
                      });

                      if (res.ok) {
                          alert('Vot înregistrat!');
                          loadPoll(); // reload fresh results
                      } else {
                          const err = await res.json();
                          alert(err.error || 'Eroare la vot');
                      }
                  } catch {
                      alert('Eroare de rețea');
                  }
              });
          }

          // Clone modal — organizers only
          const confirmClone = document.getElementById('confirmClone');
          if (confirmClone) {
              async function loadEventsForClone() {
                  try {
                      const res    = await fetch('/api/events');
                      const events = await res.json();
                      const select = document.getElementById('targetEventId');
                      events.forEach(e => {
                          const opt = document.createElement('option');
                          opt.value = e.id;
                          opt.textContent = `${e.title} (${new Date(e.startDate).toLocaleDateString()})`;
                          select.appendChild(opt);
                      });
                  } catch {}
              }

              confirmClone.addEventListener('click', async () => {
                  const cloneData = {
                      sourcePollId: parseInt(document.getElementById('sourcePollId').value),
                      targetEventId: document.getElementById('targetEventId').value || null,
                      newQuestion: document.getElementById('newQuestion').value || null,
                      deepClone: document.getElementById('deepClone').checked
                  };
                  try {
                      const res = await fetch('/api/polls/clone', {
                          method: 'POST',
                          headers: { 'Content-Type': 'application/json' },
                          body: JSON.stringify(cloneData)
                      });
                      if (res.ok) {
                          const newPoll = await res.json();
                          alert(`Sondaj clonat! ID nou: ${newPoll.id}`);
                          window.location.href = `/Polls/Details?id=${newPoll.id}`;
                      } else {
                          const err = await res.json();
                          alert('Eroare: ' + err.error);
                      }
                  } catch { alert('Eroare de rețea'); }
              });

              loadEventsForClone();
          }

          loadPoll();
     </script>
}