@page
@{
     Layout = "_Layout";
     ViewData["Title"] = "Create Poll";
     var eventId = Request.Query["eventId"];
}

<div class="container mt-4">
     <h1>Create New Poll</h1>

     <div id="message" class="alert" style="display: none;"></div>

     <form id="createPollForm">
          <input type="hidden" id="eventId" value="@eventId" />

          <div class="mb-3">
               <label for="question" class="form-label">Question *</label>
               <input type="text" class="form-control" id="question" required maxlength="500">
          </div>

          <div class="mb-3">
               <label class="form-label">Options (at least one)</label>
               <div id="optionsContainer">
                    <div class="input-group mb-2">
                         <input type="text" class="form-control" name="options" placeholder="Option 1" required>
                         <button class="btn btn-outline-danger remove-option" type="button" style="display: none;">Remove</button>
                    </div>
               </div>
               <button type="button" id="addOption" class="btn btn-sm btn-secondary">Add Option</button>
          </div>

          <div class="form-check mb-3">
               <input class="form-check-input" type="checkbox" id="allowMultiple">
               <label class="form-check-label" for="allowMultiple">
                    Allow multiple choices
               </label>
          </div>

          <div class="mb-3">
               <label for="closesAt" class="form-label">Closing Date (optional)</label>
               <input type="datetime-local" class="form-control" id="closesAt">
          </div>

          <button type="submit" class="btn btn-primary">Create Poll</button>
          <a href="/Events/Details?id=@eventId" class="btn btn-secondary">Cancel</a>
     </form>
</div>

@section Scripts {
     <script>
          // Get eventId from hidden input
          const eventId = document.getElementById('eventId').value;
          console.log('📌 Event ID:', eventId);

          let optionCount = 1;

          document.getElementById('addOption').addEventListener('click', function() {
              optionCount++;
              const container = document.getElementById('optionsContainer');
              const div = document.createElement('div');
              div.className = 'input-group mb-2';
              div.innerHTML = `
                  <input type="text" class="form-control" name="options" placeholder="Option ${optionCount}" required>
                  <button class="btn btn-outline-danger remove-option" type="button">Remove</button>
              `;
              container.appendChild(div);

              // Show remove buttons if more than one option
              document.querySelectorAll('.remove-option').forEach(btn => btn.style.display = 'block');
          });

          document.getElementById('optionsContainer').addEventListener('click', function(e) {
              if (e.target.classList.contains('remove-option')) {
                  e.target.closest('.input-group').remove();
                  optionCount--;
                  if (optionCount === 1) {
                      document.querySelectorAll('.remove-option').forEach(btn => btn.style.display = 'none');
                  }
              }
          });

          document.getElementById('createPollForm').addEventListener('submit', async function(e) {
              e.preventDefault();

              const options = [];
              document.querySelectorAll('input[name="options"]').forEach(input => {
                  if (input.value.trim()) options.push(input.value.trim());
              });

              if (options.length === 0) {
                  showMessage('danger', 'At least one option is required');
                  return;
              }

              const pollData = {
                  eventId: parseInt(document.getElementById('eventId').value),
                  question: document.getElementById('question').value,
                  options: options,
                  allowMultipleChoices: document.getElementById('allowMultiple').checked,
                  closesAt: document.getElementById('closesAt').value ? new Date(document.getElementById('closesAt').value).toISOString() : null
              };

              console.log('📡 Sending poll data:', pollData);

              try {
                  const response = await fetch('/api/polls', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify(pollData)
                  });

                  const responseData = await response.json();
                  console.log('📡 Response:', response.status, responseData);

                  if (response.ok) {
                      // Use the eventId variable we defined at the top
                      window.location.href = `/Events/Details/${eventId}`;
                  } else {
                      showMessage('danger', responseData.error || responseData.title || 'Error creating poll');
                  }
              } catch (error) {
                  console.error('❌ Error:', error);
                  showMessage('danger', 'Network error: ' + error.message);
              }
          });

          function showMessage(type, text) {
              const msg = document.getElementById('message');
              msg.style.display = 'block';
              msg.className = `alert alert-${type}`;
              msg.textContent = text;

              // Auto-hide after 5 seconds
              setTimeout(() => {
                  msg.style.display = 'none';
              }, 5000);
          }
     </script>
}
}