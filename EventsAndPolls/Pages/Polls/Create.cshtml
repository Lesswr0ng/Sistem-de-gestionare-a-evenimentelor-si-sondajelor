@page
@{
     Layout = "_Layout";
     ViewData["Title"] = "Create Poll";
     var eventId = Request.Query["eventId"];
}

<div class="container mt-4">
     <h1>Create New Poll</h1>

     <div id="message" class="alert" style="display: none;"></div>

     <form id="createPollForm">
          <input type="hidden" id="eventId" value="@eventId" />

          <div class="mb-3">
               <label for="question" class="form-label">Question *</label>
               <input type="text" class="form-control" id="question" required maxlength="500">
          </div>

          <div class="mb-3">
               <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="allowMultiple">
                    <label class="form-check-label" for="allowMultiple">
                         Allow multiple choices (lasă debifat pentru o singură opțiune)
                    </label>
               </div>
               <small class="text-muted">
                    ☑️ Bifat = Multiple Choice, 🔘 Nebifat = Single Choice
               </small>
          </div>

          <div class="mb-3">
               <label class="form-label">Options (cel puțin una)</label>
               <div id="optionsContainer">
                    <div class="input-group mb-2">
                         <input type="text" class="form-control" name="options" placeholder="Opțiune 1" required>
                         <button class="btn btn-outline-danger remove-option" type="button" style="display: none;">✖</button>
                    </div>
               </div>
               <button type="button" id="addOption" class="btn btn-sm btn-secondary">+ Adaugă Opțiune</button>
          </div>

          <div class="mb-3">
               <label for="closesAt" class="form-label">Data închiderii (opțional)</label>
               <input type="datetime-local" class="form-control" id="closesAt">
          </div>

          <button type="submit" class="btn btn-primary">Creează Sondaj</button>
          <a href="/Events/Details?id=@eventId" class="btn btn-secondary">Anulează</a>
     </form>
</div>

@section Scripts {
     <script>
          const eventId = document.getElementById('eventId').value;
          let optionCount = 1;

          // Adăugare opțiune
          document.getElementById('addOption').addEventListener('click', function() {
              optionCount++;
              const container = document.getElementById('optionsContainer');
              const div = document.createElement('div');
              div.className = 'input-group mb-2';
              div.innerHTML = `
                  <input type="text" class="form-control" name="options" placeholder="Opțiune ${optionCount}" required>
                  <button class="btn btn-outline-danger remove-option" type="button">✖</button>
              `;
              container.appendChild(div);

              document.querySelectorAll('.remove-option').forEach(btn => btn.style.display = 'block');
          });

          // Ștergere opțiune
          document.getElementById('optionsContainer').addEventListener('click', function(e) {
              if (e.target.classList.contains('remove-option')) {
                  e.target.closest('.input-group').remove();
                  optionCount--;
                  if (optionCount === 1) {
                      document.querySelectorAll('.remove-option').forEach(btn => btn.style.display = 'none');
                  }
              }
          });

          // Submit form
          document.getElementById('createPollForm').addEventListener('submit', async function(e) {
              e.preventDefault();

              // Colectează opțiunile
              const options = [];
              document.querySelectorAll('input[name="options"]').forEach(input => {
                  if (input.value.trim()) options.push(input.value.trim());
              });

              if (options.length === 0) {
                  showMessage('danger', 'Trebuie să adaugi cel puțin o opțiune');
                  return;
              }

              const pollData = {
                  eventId: parseInt(eventId),
                  question: document.getElementById('question').value,
                  allowMultipleChoices: document.getElementById('allowMultiple').checked,
                  options: options,
                  closesAt: document.getElementById('closesAt').value
                      ? new Date(document.getElementById('closesAt').value).toISOString()
                      : null
              };

              console.log('Trimit sondaj:', pollData);

              try {
                  const response = await fetch('/api/polls', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify(pollData)
                  });

                  if (response.ok) {
                      window.location.href = `/Events/Details/${eventId}`;
                  } else {
                      const error = await response.json();
                      showMessage('danger', error.error || 'Eroare la crearea sondajului');
                  }
              } catch (error) {
                  showMessage('danger', 'Eroare de rețea');
              }
          });

          function showMessage(type, text) {
              const msg = document.getElementById('message');
              msg.style.display = 'block';
              msg.className = `alert alert-${type}`;
              msg.textContent = text;

              setTimeout(() => {
                  msg.style.display = 'none';
              }, 3000);
          }
     </script>
}